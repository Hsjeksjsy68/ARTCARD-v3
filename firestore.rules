rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "grakibg@gmail.com" || 
        request.auth.token.email == "wwwrakibcom071@gmail.com" || 
        request.auth.token.email == "1@1.com"
      );
    }

    match /cards/{cardId} {
      allow read: if true;
      // Allow admins full write; allow signed-in users to update card stock on purchase/pack opening
      allow write: if request.auth != null;
    }

    match /packs/{packId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /themes/{themeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /searches/{cardId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /buy_requests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /price_history/{historyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /transactions/{txId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

